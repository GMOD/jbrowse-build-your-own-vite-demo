  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "aws s3 sync --delete dist s3://jbrowse.org/demos/byo-vite/",
    "postdeploy": "AWS_PAGER=\"\" aws cloudfront  create-invalidation --distribution-id E13LGELJOT4GQO --paths \"/demos/byo-vite/*\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "@jbrowse/display-ui": "^5.0.0-beta.13",
    "@jbrowse/react-linear-genome-view2": "^5.0.0-beta.13",
    "mobx": "^7.0.6",
    "mobx-react": "^10.0.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^17.4.0",
    "prettier": "^3.8.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.0"
  }
